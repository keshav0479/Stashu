# Reverse proxy + automatic TLS for the Stashu production deployment.
#
# The site address is DOMAIN from .env, handed over by docker-compose.prod.yml.
# Caddy fetches and renews a Let's Encrypt certificate for it, which means
# ports 80 and 443 must both be reachable from the internet and DNS must
# already point at this machine. Only that domain is served — no other domain
# is answered on this box.
#
# To get certificate-expiry warnings by mail, add a global options block as the
# very first thing in this file:
#
#   {
#       email you@example.com
#   }

{$DOMAIN} {
	encode zstd gzip

	# The app container serves both /api and the built client (SPA fallback),
	# so everything goes to one upstream.
	reverse_proxy stashu:3000
}

# Canonical host: send the www form of the same domain to the apex.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
